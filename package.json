{
  "name": "redbus-automation",
  "version": "1.0.0",
  "private": true,
  "description": "RedBus browser automation with Playwright, Cucumber BDD, and Allure",
  "main": "support/world.js",
  "scripts": {
    "pretest": "node scripts/clean-allure-results.js",
    "test": "cucumber-js",
    "pretest:bdd": "node scripts/clean-allure-results.js",
    "test:bdd": "cucumber-js",
    "pretest:smoke": "node scripts/clean-allure-results.js",
    "test:smoke": "cucumber-js --tags \"@smoke\"",
    "pretest:regression": "node scripts/clean-allure-results.js",
    "test:regression": "cucumber-js --tags \"@regression\"",
    "pretest:search": "node scripts/clean-allure-results.js",
    "test:search": "cucumber-js --tags \"@searchBus\"",
    "test:report": "npm run allure:generate",
    "allure:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "allure:open": "allure open reports/allure-report"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@playwright/test": "^1.55.0",
    "allure-commandline": "^2.34.1",
    "allure-cucumberjs": "^3.2.0",
    "dotenv": "^16.4.7"
  }
}
